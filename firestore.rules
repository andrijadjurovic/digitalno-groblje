rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function knownMemorial(memorialId) {
      return memorialId in ['1', '2', '3', '4', '5', '6', '7'];
    }

    function validCounts(data) {
      return data.keys().hasAll(['candles', 'flowers'])
        && data.keys().hasOnly(['candles', 'flowers'])
        && data.candles is int
        && data.flowers is int
        && data.candles >= 0
        && data.flowers >= 0;
    }

    match /memorialOfferings/{memorialId} {
      allow get, list: if signedIn() && knownMemorial(memorialId);

      allow create: if signedIn()
        && knownMemorial(memorialId)
        && validCounts(request.resource.data)
        && (
          (request.resource.data.candles == 1 && request.resource.data.flowers == 0)
          || (request.resource.data.candles == 0 && request.resource.data.flowers == 1)
        );

      allow update: if signedIn()
        && knownMemorial(memorialId)
        && validCounts(resource.data)
        && validCounts(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candles', 'flowers'])
        && (
          (
            request.resource.data.candles == resource.data.candles + 1
            && request.resource.data.flowers == resource.data.flowers
          )
          || (
            request.resource.data.flowers == resource.data.flowers + 1
            && request.resource.data.candles == resource.data.candles
          )
        );

      allow delete: if false;
    }

    match /memorialOfferings/{memorialId}/items/{itemId} {
      allow get, list: if signedIn() && knownMemorial(memorialId);

      allow create: if signedIn()
        && knownMemorial(memorialId)
        && request.resource.data.keys().hasAll(['productId', 'dedication', 'signature', 'createdAt'])
        && request.resource.data.keys().hasOnly(['productId', 'dedication', 'signature', 'createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 64
        && request.resource.data.dedication is string
        && request.resource.data.dedication.size() <= 180
        && request.resource.data.signature is string
        && request.resource.data.signature.size() <= 60
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /memorialGalleries/{memorialId} {
      allow get: if signedIn() && knownMemorial(memorialId);
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
